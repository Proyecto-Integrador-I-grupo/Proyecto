PORT=3000

DB_HOST=
DB_PORT=18817
DB_USER=
DB_PASSWORD=
DB_NAME=sistema_escolar_db

# API externa de Facturación al Cliente
# Si no se define, el backend usa temporalmente esta misma URL pública como respaldo.
FACTURACION_API_URL=https://proyecto-kn7p.onrender.com

# Preparado para integrar los demás servicios del proyecto sin acoplarlos al frontend.
# Cuando los otros equipos publiquen sus APIs, agrega las URLs en Render.
# Opcional: si queda vacío, EduControl usa FACTURACION_API_URL también para HTML/PDF.
DOCUMENTOS_API_URL=
DOCUMENTOS_TIMEOUT_MS=90000
XML_API_URL=
FIRMA_API_URL=
TRIBUTACION_API_URL=

# Dominio institucional permitido para usuarios y profesores
SCHOOL_EMAIL_DOMAIN=educontrol.com
