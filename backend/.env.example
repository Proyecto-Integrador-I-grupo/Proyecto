PORT=3000

DB_HOST=
DB_PORT=18817
DB_USER=
DB_PASSWORD=
DB_NAME=sistema_escolar_db

FRONTEND_URL=https://proyecto-five-ivory.vercel.app
SCHOOL_EMAIL_DOMAIN=educontrol.com
APP_TIMEZONE=America/Costa_Rica

# Seguridad de sesión. Usa un valor largo y aleatorio en producción.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
ALLOW_LEGACY_USER_HEADER=false

# Datos de respaldo del emisor si todavía no se guardó configuración desde EduControl.
FACTURACION_EMISOR_NOMBRE=EduControl
FACTURACION_EMISOR_TIPO_ID=02
FACTURACION_EMISOR_NUMERO_ID=3101000000
FACTURACION_EMISOR_CORREO=facturacion@educontrol.com

# Servicio de comprobantes Factura Bonita (opcional; si se omite se usa la URL pública predeterminada)
FACTURACION_API_URL=https://proyecto-kn7p.onrender.com
DOCUMENTOS_API_URL=https://proyecto-kn7p.onrender.com
FACTURACION_TIMEOUT_MS=45000
DOCUMENTOS_TIMEOUT_MS=45000

# Opcional: secreto exclusivo para cifrar credenciales de integraciones externas.
# Si se omite, se deriva de SESSION_SECRET.
INTEGRATION_SECRET_KEY=

# Servicio de pago actualmente disponible
BANK_CHECKOUT_URL=https://bankyfinanzas.netlify.app/checkout
BANK_LOGIN_URL=https://bankyfinanzas.netlify.app/login
BANK_REGISTER_URL=https://bankyfinanzas.netlify.app/registro/negocio
BANK_VERIFY_URL=
BANK_VERIFY_TIMEOUT_MS=12000
BANK_MERCHANT_ID=

# Se habilitarán cuando los otros equipos entreguen el contrato/endpoint REST.
FIRMA_DIGITAL_API_URL=
FACTURA_ELECTRONICA_API_URL=
TRIBUTACION_API_URL=
